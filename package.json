{
  "name": "dasto",
  "version": "0.1.0",
  "description": "Dasto — personal AI assistant that controls your Windows PC",
  "main": "main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.dasto.desktop",
    "productName": "Dasto",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
